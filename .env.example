# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# File path to persist last update_id so getUpdates only returns new messages after restart (default: telegram_offset.txt)
# TELEGRAM_OFFSET_FILE=telegram_offset.txt
# Long-poll: getUpdates blocks up to this many seconds for new messages (default 30)
GET_UPDATES_TIMEOUT=30
# Seconds to sleep after each poll cycle before next getUpdates (default 300 = 5 min)
POLL_INTERVAL_SECONDS=300

# LLM: Ollama on host (recommended) — OpenAI-compatible API on port 11434; set LLM_MODEL to your ollama model (ollama list)
LLM_API_URL=http://host.docker.internal:11434/v1/chat/completions
LLM_MODEL=qwen2.5:14b
LLM_API_KEY=
# Timeout in seconds for LLM API request (default 600 = 10 min; increase for slow local models)
LLM_REQUEST_TIMEOUT=600

# pgvector / Postgres
DB_CONNECTION_URL=postgresql://emmanuelai_user:emmanuelai_pass@emmanuelai-db:5432/emmanuelai_db
PGVECTOR_COLLECTION_NAME=emmanuelai_rag_docs
VECTOR_SIZE=384
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
# Vector retrieval: number of chunks merged into LLM context (default 20; raise if answers miss repos)
RAG_TOP_K=20

# CV / ingest paths (defaults match README)
# INGEST_KNOWLEDGE_JSON=resources/json/cv.json
# INGEST_GITHUB_JSON=resources/json/github_projects.json

# GitHub API (for scripts/fetch_github_projects.py — avoids 403 rate limits when set)
# GITHUB_TOKEN=ghp_...