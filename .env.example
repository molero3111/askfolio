# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# File path to persist last update_id so getUpdates only returns new messages after restart (default: data/telegram_offset.txt)
# TELEGRAM_OFFSET_FILE=data/telegram_offset.txt
# Long-poll: getUpdates blocks up to this many seconds for new messages (default 60)
GET_UPDATES_TIMEOUT=60
# Extra seconds to sleep between poll cycles (default 0: getUpdates already long-polls)
POLL_INTERVAL_SECONDS=0
# Heartbeat file touched each cycle; read by `python -m app.healthcheck` (keep in /tmp, not on a volume)
# HEARTBEAT_FILE=/tmp/heartbeat

# LLM: OpenRouter by default (any OpenAI-compatible endpoint works)
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# Required: OpenRouter model ID (bot exits if empty)
LLM_MODEL=
# Comma-separated OpenRouter model IDs tried in order if the primary fails
LLM_FALLBACK_MODELS=
LLM_API_KEY=
# Timeout in seconds for the LLM API request
LLM_REQUEST_TIMEOUT=60
LLM_MAX_TOKENS=800
# OpenRouter data policy: deny = skip providers that may train on prompts
LLM_DATA_COLLECTION=deny
# Optional attribution shown on OpenRouter
# LLM_APP_URL=
# LLM_APP_NAME=askfolio

# Postgres (shared by db-askfolio and the app; DSN is built from these in app/config.py)
POSTGRES_DB=askfolio_db
POSTGRES_USER=askfolio_user
# Required: set a strong password (compose refuses to start while this is empty)
POSTGRES_PASSWORD=
# Hostname/port the app uses (Compose: db service name + internal 5432)
POSTGRES_HOST=db-askfolio
POSTGRES_PORT=5432

# Changing this orphans the existing index: re-run `python -m ingest.migrate` and re-ingest
PGVECTOR_COLLECTION_NAME=rag_docs
VECTOR_SIZE=384
# Also a Docker build arg: the model is baked into the image; changing it needs a rebuild and re-ingest (--reinstall if VECTOR_SIZE changes)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
# Characters shared between adjacent chunks at ingest
CHUNK_OVERLAP=50
# Vector retrieval: number of chunks merged into LLM context (default 20; raise if answers miss repos)
RAG_TOP_K=20

# CV / ingest paths (defaults match README)
# INGEST_KNOWLEDGE_JSON=resources/json/cv.json
# INGEST_GITHUB_JSON=resources/json/github_projects.json
# Comma-separated repo names to ingest from that file; empty ingests every repo in it.
# Every name must exist in the file, or ingest stops without changing anything.
# INGEST_GITHUB_REPOS=my-api,my-web-app

# GitHub API (for scripts/fetch_github_projects.py — avoids 403 rate limits when set)
# GITHUB_TOKEN=ghp_...

# LangSmith tracing (optional). Tracing is enabled only when LANGSMITH_API_KEY is set.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=askfolio-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Hugging Face API token (optional). The embedding model is baked into the image and runs
# offline, so this is only needed when building the image with a gated model.
#HF_TOKEN=hf_...

# Google Calendar integration (optional — required for meeting scheduling)
# Run scripts/authorize_calendar.py once locally to generate secrets/token.json
GOOGLE_CREDENTIALS_PATH=secrets/credentials.json
GOOGLE_TOKEN_PATH=secrets/token.json
GOOGLE_CALENDAR_ID=primary
# Developer's timezone for slot display (e.g. Europe/Madrid, America/New_York, UTC)
CALENDAR_TIMEZONE=UTC
# Timezone shown to recruiters in slot labels (independent of developer's local timezone)
CALENDAR_DISPLAY_TIMEZONE=America/New_York
CALENDAR_SLOT_DURATION_MINUTES=60
CALENDAR_WORKING_HOURS_START=9
CALENDAR_WORKING_HOURS_END=18
CALENDAR_DAYS_AHEAD=7
# Timezone resolution: LLM is primary by default. Set to true to enable the alias dict
# as a fast-path (no LLM call) before falling back to LLM for unrecognized inputs.
TIMEZONE_ALIAS_FAST_PATH=false

# Rate limits (in-memory, reset on restart; day windows are UTC calendar days)
# Max messages per chat in any sliding 60 seconds
RATE_LIMIT_PER_CHAT_PER_MINUTE=5
# Max messages per chat per UTC day
RATE_LIMIT_PER_CHAT_PER_DAY=50
# Max messages across all chats per UTC day. Keep this under the OpenRouter
# free-model daily cap (50 requests/day) so the bot's own limit hits first.
# This counts messages, not upstream requests: a retry or fallback can double the requests
# for one message, so leave headroom under a provider's daily cap.
RATE_LIMIT_GLOBAL_PER_DAY=45
# Max meetings one chat can book per UTC day
RATE_LIMIT_BOOKINGS_PER_CHAT_PER_DAY=1
# Max meetings booked across all chats per UTC day
RATE_LIMIT_BOOKINGS_GLOBAL_PER_DAY=5
# Master switch for meeting booking (code default is false: booking stays off unless explicitly enabled)
BOOKING_ENABLED=false
